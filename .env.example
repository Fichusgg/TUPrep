# Copy to .env.local (never commit it) or set these in Vercel → Project → Settings → Environment Variables.
# Only needed for the optional AI tutor; everything else works without them.

# Your Anthropic API key (https://console.anthropic.com). Placeholder only:
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model id used by the tutor. The code never hard-codes a model; pick one, e.g. the current default:
ANTHROPIC_MODEL=claude-opus-5-5
