      "code": "const f=x=> Math.abs(x)/x; const l=h.limit(f,0,\"left\"), r=h.limit(f,0,\"right\"); if(Math.abs(l-r)>1e-6) return {index:3}; return {index: [1,-1,0].findIndex(v=> Math.abs(v-l)<1e-6)};"
    }
